<ui:FluentWindow x:Class="ACMECertManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ACME Certificate Manager"
    Height="760"
    Width="1180"
    MinHeight="640"
    MinWidth="980"
    Icon="assets/app.ico"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="ACME Certificate Manager"
            Icon="assets/app.ico"
            ShowClose="True"
            ShowMaximize="True"
            ShowMinimize="True"/>

        <ui:NavigationView
            x:Name="NavPrimaryMenu"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            OpenPaneLength="268"
            IsPaneToggleVisible="True"
            IsBackButtonVisible="Collapsed"
            HeaderVisibility="Collapsed"
            AlwaysShowHeader="False"
            TitleBar="{Binding ElementName=AppTitleBar}"
            ItemInvoked="NavPrimaryMenu_ItemInvoked"
            Margin="0">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Manage Certificates"
                    Tag="Manage"
                    TargetPageTag="Manage"
                    Icon="{ui:SymbolIcon DocumentOnePage24}"
                    Click="NavMenuItem_Click"/>
                <ui:NavigationViewItem
                    Content="Issue Certificate"
                    Tag="Issue"
                    TargetPageTag="Issue"
                    Icon="{ui:SymbolIcon AddCircle24}"
                    Click="NavMenuItem_Click"/>
                <ui:NavigationViewItem
                    Content="Logs"
                    Tag="Logs"
                    TargetPageTag="Logs"
                    Icon="{ui:SymbolIcon DocumentText24}"
                    Click="NavMenuItem_Click"/>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="Settings"
                    Tag="Settings"
                    TargetPageTag="Settings"
                    Icon="{ui:SymbolIcon Settings24}"
                    Click="NavMenuItem_Click"/>
            </ui:NavigationView.FooterMenuItems>

            <!--
              WPF-UI NavigationView has no content children. ContentOverlay fills the content
              region and can overlap Header, so keep the section header + pages in one grid.
            -->
            <ui:NavigationView.ContentOverlay>
            <Grid Margin="20,8,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock
                        x:Name="txtSectionTitle"
                        Text="Manage Certificates"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock
                        x:Name="txtSectionSubtitle"
                        Text="Review, renew, revoke, or delete existing local certificates."
                        Margin="0,4,0,0"
                        FontSize="13"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Grid Grid.Row="1">
                <!-- Manage -->
                <Grid x:Name="ManagePage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:Card
                        Grid.Row="0"
                        Padding="0"
                        Margin="0,0,0,12"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <ui:DataGrid
                            x:Name="dgCertificates"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserResizeColumns="True"
                            HeadersVisibility="Column"
                            GridLinesVisibility="Horizontal"
                            BorderThickness="0"
                            MinColumnWidth="120"
                            ColumnWidth="SizeToHeader"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="2*" MinWidth="220"/>
                                <DataGridTextColumn Header="Expires" Binding="{Binding Expires, StringFormat={}{0:yyyy-MM-dd}}" Width="SizeToHeader" MinWidth="130"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="SizeToHeader" MinWidth="120"/>
                                <DataGridTextColumn Header="ACME Server" Binding="{Binding AcmeDirectoryUrl}" Width="*" MinWidth="260"/>
                                <DataGridTextColumn Header="Validation" Binding="{Binding ValidationMethod}" Width="SizeToHeader" MinWidth="130"/>
                            </DataGrid.Columns>
                        </ui:DataGrid>
                    </ui:Card>

                    <StackPanel
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                        <ui:Button
                            Content="Renew"
                            Icon="{ui:SymbolIcon ArrowClockwise24}"
                            Appearance="Primary"
                            Click="Renew_Click"
                            MinWidth="140"
                            Margin="0,0,8,0"/>
                        <ui:Button
                            Content="Revoke (CA)"
                            Icon="{ui:SymbolIcon ShieldDismiss24}"
                            Appearance="Caution"
                            Click="Revoke_Click"
                            MinWidth="150"
                            Margin="0,0,8,0"/>
                        <ui:Button
                            Content="Delete (Local)"
                            Icon="{ui:SymbolIcon Delete24}"
                            Appearance="Danger"
                            Click="Delete_Click"
                            MinWidth="150"
                            Margin="0,0,8,0"/>
                        <ui:Button
                            Content="Open Folder"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Appearance="Secondary"
                            Click="OpenFolder_Click"
                            MinWidth="150"/>
                    </StackPanel>
                </Grid>

                <!-- Issue -->
                <ScrollViewer
                    x:Name="IssuePage"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="Collapsed">
                    <StackPanel>
                        <ui:Card Margin="0,0,0,12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Certificate Request" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                <TextBlock Text="Domain(s)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ui:TextBox
                                    x:Name="txtDomains"
                                    PlaceholderText="example.com, www.example.com or *.example.com"
                                    Margin="0,0,0,14"/>

                                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ui:TextBox
                                    x:Name="txtEmail"
                                    PlaceholderText="you@example.com"
                                    Margin="0,0,0,4"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Validation Method" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        x:Name="rbHttp"
                                        GroupName="ValidationMethod"
                                        Content="HTTP-01"
                                        IsChecked="True"
                                        Margin="0,0,20,0"
                                        Checked="ValidationMethod_Checked"/>
                                    <RadioButton
                                        x:Name="rbTls"
                                        GroupName="ValidationMethod"
                                        Content="TLS-ALPN-01"
                                        Margin="0,0,20,0"
                                        Checked="ValidationMethod_Checked"/>
                                    <RadioButton
                                        x:Name="rbDns"
                                        GroupName="ValidationMethod"
                                        Content="DNS-01 (plugin)"
                                        Checked="ValidationMethod_Checked"/>
                                </StackPanel>

                                <StackPanel x:Name="txtRelaunchAsAdmin" Margin="0,14,0,0" Visibility="Collapsed">
                                    <ui:InfoBar
                                        Title="Administrator required"
                                        Message="HTTP self-hosted and TLS-ALPN validation need elevated rights for port binding."
                                        Severity="Warning"
                                        IsOpen="True"
                                        IsClosable="False"/>
                                    <ui:Button
                                        Content="Re-launch as Administrator"
                                        Appearance="Caution"
                                        Icon="{ui:SymbolIcon ShieldError24}"
                                        Click="RelaunchAsAdmin_Click"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        MinWidth="240"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card x:Name="grpHttpDeployment" Margin="0,0,0,12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="HTTP-01 Deployment" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock
                                    Text="Choose how to publish /.well-known/acme-challenge/{token}. Self-hosted uses a temporary listener on port 80."
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Margin="0,0,0,12"/>

                                <TextBlock Text="Deployment Method" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox
                                    x:Name="cmbHttpDeploymentMethod"
                                    SelectionChanged="HttpDeploymentMethod_Changed"
                                    Margin="0,0,0,12">
                                    <ComboBoxItem Tag="SelfHosted" IsSelected="True" Content="Self-hosted listener (port 80)"/>
                                    <ComboBoxItem Tag="NetworkPath" Content="Save to local/network path (UNC supported)"/>
                                    <ComboBoxItem Tag="Ftp" Content="FTP upload"/>
                                    <ComboBoxItem Tag="Sftp" Content="SFTP upload"/>
                                    <ComboBoxItem Tag="WebDav" Content="WebDav upload"/>
                                    <ComboBoxItem Tag="Rest" Content="REST endpoint"/>
                                </ComboBox>

                                <StackPanel x:Name="pnlHttpTarget" Margin="0,0,0,10" Visibility="Collapsed">
                                    <TextBlock Text="Target (directory path or endpoint URL)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ui:TextBox
                                        x:Name="txtHttpTarget"
                                        PlaceholderText="\\server\share\.well-known\acme-challenge or https://host/..."/>
                                </StackPanel>

                                <StackPanel x:Name="pnlHttpCredentials" Margin="0,0,0,10" Visibility="Collapsed">
                                    <TextBlock Text="Authentication" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ui:TextBox
                                        x:Name="txtHttpUsername"
                                        PlaceholderText="Username"
                                        Margin="0,0,0,8"/>
                                    <ui:PasswordBox
                                        x:Name="txtHttpPassword"
                                        PlaceholderText="Password"/>
                                </StackPanel>

                                <StackPanel x:Name="pnlHttpRest" Margin="0,0,0,10" Visibility="Collapsed">
                                    <TextBlock Text="REST Options" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ui:TextBox x:Name="txtHttpRestMethod" Text="POST" PlaceholderText="HTTP method" Margin="0,0,0,8"/>
                                    <ui:TextBox x:Name="txtHttpBearerToken" PlaceholderText="Bearer token (optional)" Margin="0,0,0,8"/>
                                    <ui:TextBox x:Name="txtHttpHeaderName" PlaceholderText="Additional header name (optional)" Margin="0,0,0,8"/>
                                    <ui:TextBox x:Name="txtHttpHeaderValue" PlaceholderText="Additional header value (optional)" Margin="0,0,0,8"/>
                                    <CheckBox
                                        x:Name="chkHttpSkipTlsValidation"
                                        Content="Skip TLS certificate validation (for private/self-signed endpoints)"/>
                                </StackPanel>

                                <StackPanel x:Name="pnlHttpPublicProbe" Visibility="Collapsed">
                                    <TextBlock Text="Public Probe URL Template" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ui:TextBox
                                        x:Name="txtHttpPublicProbeTemplate"
                                        Text="http://{domain}/.well-known/acme-challenge/{token}"
                                        PlaceholderText="http://{domain}/.well-known/acme-challenge/{token}"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card x:Name="grpDnsPlugin" Margin="0,0,0,12" Padding="20" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="DNS Plugin Configuration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ui:InfoBar
                                    Title="Plaintext secret storage"
                                    Message="DNS plugin secrets are stored as plaintext inside storage/dns-secrets.json."
                                    Severity="Warning"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Margin="0,0,0,12"/>

                                <TextBlock Text="DNS Provider Plugin" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox
                                    x:Name="cmbDnsPlugin"
                                    SelectionChanged="DnsPluginSelection_Changed"
                                    DisplayMemberPath="DisplayName"
                                    Margin="0,0,0,10"/>

                                <TextBlock
                                    x:Name="txtPluginDescription"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,8"/>

                                <StackPanel x:Name="pnlDnsFields"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:CardExpander
                            Header="Advanced Options"
                            Icon="{ui:SymbolIcon Options24}"
                            IsExpanded="False"
                            Margin="0,0,0,16"
                            Padding="8">
                            <StackPanel Margin="8,4,8,8">
                                <CheckBox
                                    x:Name="chkCreatePfxFile"
                                    Content="Also create a PFX file (certificate.pfx)"
                                    Margin="0,0,0,12"/>

                                <TextBlock Text="Private Key Algorithm" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox
                                    x:Name="cmbKeyAlgorithm"
                                    Margin="0,0,0,12"
                                    ToolTip="RSA-2048 (RS256) is widely compatible. ECDSA P-256/P-384 (ES256/ES384) is modern and preferred by many CAs.">
                                    <ComboBoxItem Tag="RS256" IsSelected="True" Content="RSA 2048 (RS256)"/>
                                    <ComboBoxItem Tag="ES256" Content="ECDSA P-256 (ES256)"/>
                                    <ComboBoxItem Tag="ES384" Content="ECDSA P-384 (ES384)"/>
                                </ComboBox>

                                <CheckBox
                                    x:Name="chkUseStaging"
                                    Content="Use Let's Encrypt staging server (test certificates only)"
                                    Margin="0,0,0,12"/>

                                <TextBlock Text="Custom ACME directory URL (optional)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ui:TextBox
                                    x:Name="txtCustomAcmeDirectoryUrl"
                                    PlaceholderText="https://acme-v02.api.letsencrypt.org/directory"/>
                            </StackPanel>
                        </ui:CardExpander>

                        <ui:Button
                            Content="Issue Certificate Now"
                            Icon="{ui:SymbolIcon Rocket24}"
                            Appearance="Primary"
                            Click="IssueCertificate_Click"
                            HorizontalAlignment="Left"
                            MinWidth="240"
                            Height="44"
                            FontSize="15"
                            Margin="0,4,0,12"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer
                    x:Name="SettingsPage"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="Collapsed">
                    <StackPanel>
                        <ui:Card Margin="0,0,0,12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock
                                    Text="Choose a fixed app theme or follow your Windows theme automatically."
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,12"/>
                                <TextBlock Text="Application Theme" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox
                                    x:Name="cmbAppearanceTheme"
                                    Width="260"
                                    HorizontalAlignment="Left"
                                    SelectionChanged="AppearanceTheme_Changed">
                                    <ComboBoxItem Tag="System Default" Content="System Default"/>
                                    <ComboBoxItem Tag="Light" Content="Light"/>
                                    <ComboBoxItem Tag="Dark" Content="Dark"/>
                                </ComboBox>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Stored Secrets" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock
                                    Text="Review and manage DNS plugin credentials stored on this machine."
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,12"/>
                                <ui:Button
                                    Content="Manage DNS Secrets"
                                    Icon="{ui:SymbolIcon Key24}"
                                    Appearance="Secondary"
                                    Click="ViewDnsSecrets_Click"
                                    HorizontalAlignment="Left"
                                    MinWidth="200"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,12" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Logging" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock
                                    Text="Control how large log files can grow before rotation."
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Margin="0,0,0,12"/>
                                <TextBlock Text="Max Log File Size (MB)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ui:NumberBox
                                    x:Name="txtMaxLogFileSizeMb"
                                    Width="160"
                                    HorizontalAlignment="Left"
                                    Minimum="1"
                                    Maximum="1024"
                                    MaxDecimalPlaces="0"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="MaxLogFileSize_ValueChanged"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="20">
                            <StackPanel>
                                <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock
                                    x:Name="txtAppVersion"
                                    Text="Version v1.4.0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- Logs -->
                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <ui:Button
                                Content="Export Logs"
                                Icon="{ui:SymbolIcon ArrowDownload24}"
                                Appearance="Primary"
                                Click="ExportLogs_Click"
                                MinWidth="140"
                                Margin="0,0,8,0"/>
                            <ui:Button
                                Content="Clear Logs"
                                Icon="{ui:SymbolIcon Delete24}"
                                Appearance="Secondary"
                                Click="ClearLogs_Click"
                                MinWidth="130"/>
                        </StackPanel>
                        <TextBlock
                            x:Name="txtLogStats"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </DockPanel>

                    <ui:Card
                        Grid.Row="1"
                        Padding="0"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <ui:TextBox
                            x:Name="txtLogs"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            HorizontalContentAlignment="Left"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            FontFamily="Cascadia Mono, Consolas, Courier New"
                            FontSize="12"
                            BorderThickness="0"
                            PlaceholderText="Application activity will appear here."/>
                    </ui:Card>
                </Grid>
                </Grid>
            </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
