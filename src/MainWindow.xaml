<Window x:Class="ACMECertManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACME Certificate Manager" Height="700" Width="1100"
        Background="#F5F5F5" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <TabControl TabStripPlacement="Top" Background="White" BorderThickness="0">
            <!-- Dashboard -->
            <TabItem Header="📊 Dashboard">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <TextBlock Text="🎉 Welcome to ACME Certificate Manager!" FontSize="28" FontWeight="Bold" Foreground="#00BFFF" Margin="0,0,0,20"/>
                    <TextBlock Text="Default = STAGING mode (safe for testing)" FontSize="18" Foreground="Green" Margin="0,0,0,30"/>
                    <Button Content="✨ Issue Your First Certificate" Click="IssueButton_Click" Height="60" Width="380" FontSize="20" Background="#00BFFF" Foreground="White" BorderThickness="0" Margin="0,10"/>
                    <TextBlock Text="All certificates saved inside this folder – no mess!" FontSize="14" Margin="0,30" HorizontalAlignment="Center"/>
                </StackPanel>
            </TabItem>

            <!-- Issue New Certificate -->
            <TabItem Header="✨ Issue New Certificate">
                <Grid Margin="30">
                    <StackPanel>
                        <TextBlock Text="Domain(s) (example.com,www.example.com or *.example.com)" FontSize="15" Margin="0,10,0,5" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtDomains" Height="35" Margin="0,0,0,15" FontSize="14" Padding="10"/>

                        <TextBlock Text="Your Email" FontSize="15" Margin="0,10,0,5" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtEmail" Height="35" Margin="0,0,0,15" FontSize="14" Padding="10"/>

                        <GroupBox Header="Validation Method" Margin="0,15">
                            <StackPanel Orientation="Horizontal" Margin="15">
                                <RadioButton x:Name="rbHttp" Content="HTTP-01 (easiest - auto)" IsChecked="True" Margin="0,0,40,0" FontSize="14"/>
                                <RadioButton x:Name="rbDns" Content="DNS-01 (Cloudflare/AWS - manual)" FontSize="14"/>
                            </StackPanel>
                        </GroupBox>

                        <CheckBox x:Name="chkProduction" Content="🚨 SWITCH TO PRODUCTION MODE (real certificates)" Margin="0,20" FontSize="14" Foreground="Red" FontWeight="Bold"/>

                        <Button Content="🚀 Issue Certificate Now" Click="IssueCertificate_Click" Height="55" Width="320" FontSize="18" Background="#00BFFF" Foreground="White" Margin="0,30"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Manage Certificates -->
            <TabItem Header="📋 Manage Certificates">
                <Grid>
                    <DataGrid x:Name="dgCertificates" AutoGenerateColumns="True" Margin="10" IsReadOnly="True" ColumnWidth="*"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20">
                        <Button Content="🔄 Renew Selected" Click="Renew_Click" Width="160" Height="40" Margin="10" Background="#00BFFF" Foreground="White"/>
                        <Button Content="⛔ Revoke Selected" Click="Revoke_Click" Width="160" Height="40" Margin="10" Background="#FF4444" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="⚙️ Settings">
                <StackPanel Margin="30">
                    <TextBlock Text="Auto-Renewal" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Creates a Windows Task Scheduler task to check/renew every 60 days." FontSize="14" Margin="0,0,0,20"/>
                    <Button Content="Enable Auto-Renew Now" Click="EnableAutoRenew_Click" Height="50" Width="300" FontSize="16" Background="#00BFFF" Foreground="White"/>
                    <TextBlock Text="💡 Tip: Run the app once after enabling." FontSize="13" Margin="0,30" Foreground="Gray"/>
                    <TextBlock Text="All files stay INSIDE this app folder." FontSize="13" Margin="0,10" Foreground="Gray"/>
                </StackPanel>
            </TabItem>

            <!-- Logs -->
            <TabItem Header="📜 Logs">
                <TextBox x:Name="txtLogs" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Margin="10" FontFamily="Consolas" FontSize="13" Background="#1E1E1E" Foreground="#00FF00"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
