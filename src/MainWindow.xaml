<ui:FluentWindow x:Class="ACMECertManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ACME Certificate Manager" Height="700" Width="1100"
    Icon="assets/app.ico"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource PrimaryTextBrush}"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"/>
                            <Grid Margin="2">
                                <ToggleButton x:Name="ToggleButton"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <Popup x:Name="Popup"
                                       AllowsTransparency="True"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       PopupAnimation="Fade"
                                       Focusable="False">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,6,0,0">
                                        <ScrollViewer Margin="0">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReadableComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ReadableComboBoxItemStyle}"/>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource WindowBackgroundBrush}"/>
        </Style>

        <Style x:Key="SideNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NavSelectedBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource NavSelectedBorderBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Margin="0" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="0"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ui:NavigationView x:Name="NavPrimaryMenu"
                               Grid.Row="0"
                               ItemInvoked="NavPrimaryMenu_ItemInvoked"
                               IsPaneOpen="True"
                               IsPaneToggleVisible="False"
                               IsBackButtonVisible="Collapsed"
                               Background="Transparent">
                    <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Tag="Manage" Click="NavMenuItem_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Document20" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Manage Certificates" VerticalAlignment="Center"/>
                        </Grid>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Tag="Issue" Click="NavMenuItem_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Add20" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Issue New Certificate" VerticalAlignment="Center"/>
                        </Grid>
                    </ui:NavigationViewItem>
                    <ui:NavigationViewItem Tag="Logs" Click="NavMenuItem_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="DocumentText20" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Logs" VerticalAlignment="Center"/>
                        </Grid>
                    </ui:NavigationViewItem>
                    </ui:NavigationView.MenuItems>
                    <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Tag="Settings" Click="NavMenuItem_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Settings20" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center"/>
                        </Grid>
                    </ui:NavigationViewItem>
                    </ui:NavigationView.FooterMenuItems>
                </ui:NavigationView>

            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0"
                CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceBrush}">
                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <!-- Section title + subtitle -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock x:Name="txtSectionTitle" Text="Manage Certificates" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="txtSectionSubtitle" Text="Review, renew, revoke, or delete existing local certificates." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- Title bar (window buttons) placed top-right -->
                        <ui:TitleBar Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" ShowClose="True" ShowMaximize="True" ShowMinimize="True"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                <!-- Manage Certificates -->
                <Grid x:Name="ManagePage" Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgCertificates"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              Margin="10"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeaderWidth="36"
                              ColumnWidth="SizeToHeader"
                              MinColumnWidth="120"
                              CanUserResizeColumns="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.RowHeaderStyle>
                            <Style TargetType="{x:Type DataGridRowHeader}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <RadioButton Focusable="False"
                                                         IsHitTestVisible="False"
                                                         IsChecked="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected, Mode=OneWay}"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="2*" MinWidth="220"/>
                            <DataGridTextColumn Header="Expires" Binding="{Binding Expires, StringFormat={}{0:yyyy-MM-dd}}" Width="SizeToHeader" MinWidth="130"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="SizeToHeader" MinWidth="120"/>
                            <DataGridTextColumn Header="ACME Server" Binding="{Binding AcmeDirectoryUrl}" Width="*" MinWidth="260"/>
                            <DataGridTextColumn Header="Validation" Binding="{Binding ValidationMethod}" Width="SizeToHeader" MinWidth="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Button Content="🔄 Renew" Click="Renew_Click" Width="160" Height="40" Margin="10"/>
                        <Button Content="⛔ Revoke (CA)" Click="Revoke_Click" Width="200" Height="40" Margin="10" Background="{DynamicResource WarningBrush}"/>
                        <Button Content="🗑 Delete (Local)" Click="Delete_Click" Width="200" Height="40" Margin="10"/>
                    </StackPanel>
                </Grid>

                <!-- Issue New Certificate -->
                <ScrollViewer x:Name="IssuePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <Grid Margin="30">
                        <StackPanel>
                            <TextBlock Text="Domain(s) (example.com,www.example.com or *.example.com)" FontSize="15" Margin="0,10,0,5" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtDomains" Height="40" Margin="0,0,0,15" FontSize="14" Padding="10,7" VerticalContentAlignment="Center"/>

                            <TextBlock Text="Your Email" FontSize="15" Margin="0,10,0,5" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtEmail" Height="40" Margin="0,0,0,15" FontSize="14" Padding="10,7" VerticalContentAlignment="Center"/>

                            <GroupBox Header="Validation Method" Margin="0,15">
                                <StackPanel Margin="15" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="rbHttp" GroupName="ValidationMethod" Content="HTTP-01" IsChecked="True" FontSize="14" VerticalAlignment="Center" Margin="0,0,24,0" Checked="ValidationMethod_Checked"/>
                                        <RadioButton x:Name="rbTls" GroupName="ValidationMethod" Content="TLS-ALPN-01" FontSize="14" VerticalAlignment="Center" Margin="0,0,24,0" Checked="ValidationMethod_Checked"/>
                                        <RadioButton x:Name="rbDns" GroupName="ValidationMethod" Content="DNS-01 (plugin)" FontSize="14" VerticalAlignment="Center" Checked="ValidationMethod_Checked"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtRelaunchAsAdmin" Margin="0,8,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource WarningBrush}">
                                        <Hyperlink Click="RelaunchAsAdmin_Click">Re-launch as Administrator</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="grpHttpDeployment" Header="HTTP-01 Deployment" Margin="0,10">
                                <StackPanel Margin="15">
                                    <TextBlock Text="Choose how to publish /.well-known/acme-challenge/{token}. Self-hosted uses a temporary listener on port 80." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                                    <TextBlock Text="Deployment Method" FontSize="14" Margin="0,2,0,5" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="cmbHttpDeploymentMethod" Height="34" SelectionChanged="HttpDeploymentMethod_Changed" Margin="0,0,0,10" ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}">
                                        <ComboBoxItem Tag="SelfHosted" IsSelected="True">Self-hosted listener (port 80)</ComboBoxItem>
                                        <ComboBoxItem Tag="NetworkPath">Save to local/network path (UNC supported)</ComboBoxItem>
                                        <ComboBoxItem Tag="Ftp">FTP upload</ComboBoxItem>
                                        <ComboBoxItem Tag="Sftp">SFTP upload</ComboBoxItem>
                                        <ComboBoxItem Tag="WebDav">WebDav upload</ComboBoxItem>
                                        <ComboBoxItem Tag="Rest">REST endpoint</ComboBoxItem>
                                    </ComboBox>

                                    <StackPanel x:Name="pnlHttpTarget" Margin="0,2,0,8" Visibility="Collapsed">
                                        <TextBlock Text="Target (directory path or endpoint URL)" FontSize="13" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                        <TextBox x:Name="txtHttpTarget" Height="34" Padding="8,4" ToolTip="Examples: \\\\server\\share\\.well-known\\acme-challenge, ftp://host/.well-known/acme-challenge, sftp://host:22/.well-known/acme-challenge, https://host/webdav/.well-known/acme-challenge, https://api.example.com/acme/challenge"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlHttpCredentials" Margin="0,2,0,8" Visibility="Collapsed">
                                        <TextBlock Text="Authentication (when required)" FontSize="13" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                        <TextBox x:Name="txtHttpUsername" Height="34" Padding="8,4" Margin="0,0,0,6" ToolTip="Username"/>
                                        <PasswordBox x:Name="txtHttpPassword" Height="34" Padding="8,4" ToolTip="Password"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlHttpRest" Margin="0,2,0,8" Visibility="Collapsed">
                                        <TextBlock Text="REST Options" FontSize="13" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                        <TextBox x:Name="txtHttpRestMethod" Height="34" Padding="8,4" Margin="0,0,0,6" Text="POST" ToolTip="HTTP method (for present and cleanup calls)"/>
                                        <TextBox x:Name="txtHttpBearerToken" Height="34" Padding="8,4" Margin="0,0,0,6" ToolTip="Bearer token (optional)"/>
                                        <TextBox x:Name="txtHttpHeaderName" Height="34" Padding="8,4" Margin="0,0,0,6" ToolTip="Additional header name (optional)"/>
                                        <TextBox x:Name="txtHttpHeaderValue" Height="34" Padding="8,4" ToolTip="Additional header value (optional)"/>
                                        <CheckBox x:Name="chkHttpSkipTlsValidation" Content="Skip TLS certificate validation (for private/self-signed endpoints)" Margin="0,8,0,0" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlHttpPublicProbe" Margin="0,2,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Public Probe URL Template" FontSize="13" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                        <TextBox x:Name="txtHttpPublicProbeTemplate" Height="34" Padding="8,4" Text="http://{domain}/.well-known/acme-challenge/{token}" ToolTip="Optional probe URL before challenge validation. Use placeholders {domain} and {token}."/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="grpDnsPlugin" Header="DNS Plugin Configuration" Margin="0,10" Visibility="Collapsed">
                                <StackPanel Margin="15">
                                    <TextBlock Text="Warning: DNS plugin secrets are stored as plaintext inside storage/dns-secrets.json." FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <TextBlock Text="DNS Provider Plugin" FontSize="14" Margin="0,2,0,5" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="cmbDnsPlugin" Height="34" SelectionChanged="DnsPluginSelection_Changed" DisplayMemberPath="DisplayName" Margin="0,0,0,10" ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}"/>

                                    <TextBlock x:Name="txtPluginDescription" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <StackPanel x:Name="pnlDnsFields" />
                                </StackPanel>
                            </GroupBox>

                            <Expander Header="Advanced Options" Margin="0,20,0,0" IsExpanded="False">
                                <StackPanel Margin="15,8,15,10">
                                    <CheckBox x:Name="chkCreatePfxFile"
                                              Content="Also create a PFX file (certificate.pfx)"
                                              Margin="0,0,0,12"
                                              FontSize="13"/>

                                    <CheckBox x:Name="chkUseStaging"
                                              Content="Use Let's Encrypt staging server (test certificates only)"
                                              Margin="0,0,0,12"
                                              FontSize="13"/>

                                    <TextBlock Text="Custom ACME directory URL (optional)" FontSize="13" Margin="0,0,0,4" FontWeight="SemiBold"/>
                                    <TextBox x:Name="txtCustomAcmeDirectoryUrl"
                                             Height="34"
                                             Padding="8,4"
                                             ToolTip="If set, this overrides Let's Encrypt production/staging selection. Example: https://acme-v02.api.letsencrypt.org/directory"/>
                                </StackPanel>
                            </Expander>

                            <Button Content="🚀 Issue Certificate Now" Click="IssueCertificate_Click" Height="55" Width="320" FontSize="18" Margin="0,30"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="30">
                        <TextBlock Text="Appearance" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Application Theme" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cmbAppearanceTheme"
                                      Height="34"
                                      Width="240"
                                      SelectionChanged="AppearanceTheme_Changed"
                                      ItemContainerStyle="{StaticResource ReadableComboBoxItemStyle}">
                                <ComboBoxItem Tag="System Default">System Default</ComboBoxItem>
                                <ComboBoxItem Tag="Light">Light</ComboBoxItem>
                                <ComboBoxItem Tag="Dark">Dark</ComboBoxItem>
                            </ComboBox>
                            <TextBlock Text="Choose a fixed app theme or follow your Windows theme automatically." FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock Text="Stored Secrets" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Button Content="View" Click="ViewDnsSecrets_Click" Height="40" Width="260" FontSize="14" Margin="0,0,0,20"/>

                        <TextBlock Text="Logging" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
                            <TextBlock Text="Max Log File Size (MB)" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="txtMaxLogFileSizeMb" Width="80" Height="32" FontSize="14" Padding="8,4" VerticalContentAlignment="Center" TextChanged="MaxLogFileSize_Changed"/>
                            <TextBlock Text="(current usage shown in Logs tab)" FontSize="12" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Logs -->
                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">
                        <Button Content="📥 Export Logs" Click="ExportLogs_Click" Height="40" Width="140" FontSize="14" Margin="0,0,10,0"/>
                        <Button Content="🗑 Clear Logs" Click="ClearLogs_Click" Height="40" Width="120" FontSize="14"/>
                        <TextBlock x:Name="txtLogStats" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    </StackPanel>

                    <TextBox x:Name="txtLogs" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Margin="10" FontFamily="Consolas" FontSize="13"/>
                </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
