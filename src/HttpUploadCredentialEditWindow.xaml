<ui:FluentWindow x:Class="ACMECertManager.HttpUploadCredentialEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Edit HTTP Upload Credentials"
        Height="680"
        Width="680"
        MinHeight="560"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="Edit HTTP Upload Credentials"
            ShowClose="True"
            ShowMaximize="False"
            ShowMinimize="False"/>

        <Grid Grid.Row="1" Margin="20,12,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock
                    Text="HTTP Upload Credentials"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock
                    Text="These values are written back to this certificate in certificates.json and reused on renewal."
                    Margin="0,4,0,0"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <ui:Card Grid.Row="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Certificate" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtDomain" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="Output folder" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtOutputDirectory" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="Deployment method" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtMethod" Margin="0,0,0,10"/>

                        <TextBlock Text="Target" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ui:TextBox x:Name="txtTarget" Margin="0,0,0,10"/>

                        <TextBlock Text="Port (optional)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ui:TextBox x:Name="txtPort" PlaceholderText="Blank uses the URL or method default" Margin="0,0,0,10"/>

                        <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ui:TextBox x:Name="txtUsername" Margin="0,0,0,10"/>

                        <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ui:PasswordBox
                            x:Name="txtPassword"
                            RevealButtonEnabled="True"
                            Margin="0,0,0,10"/>

                        <TextBlock Text="Bearer token" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ui:PasswordBox
                            x:Name="txtBearerToken"
                            RevealButtonEnabled="True"
                            Margin="0,0,0,10"/>

                        <TextBlock Text="Additional header value" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ui:TextBox x:Name="txtHeaderValue"/>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button
                    Content="Save"
                    Appearance="Primary"
                    Click="Save_Click"
                    MinWidth="120"
                    Margin="0,0,8,0"/>
                <ui:Button
                    Content="Cancel"
                    Appearance="Secondary"
                    Click="Cancel_Click"
                    MinWidth="120"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
