<ui:FluentWindow x:Class="ACMECertManager.DnsSecretEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Edit DNS Plugin Credentials" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Plugin Info -->
        <Border Grid.Row="0" Background="{DynamicResource InputBackgroundBrush}" Padding="15" Margin="15,15,15,0">
            <StackPanel>
                <TextBlock x:Name="txtPluginName" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="txtPluginDescription" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="15">
                <!-- Domain field -->
                <TextBlock Text="Domain/Context hostname (e.g., example.com, leave blank only for default/shared credentials)" FontSize="13" Margin="0,10,0,5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="txtDomain" Height="34" Padding="10,7" FontSize="12" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- Credential fields -->
                <StackPanel x:Name="pnlCredentialFields" Margin="0,20,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15" Height="50">
            <Button x:Name="btnSave" Content="Save" Click="Save_Click" Height="40" Width="120" FontSize="13" Margin="0,0,10,0"/>
            <Button Content="Cancel" Click="Cancel_Click" Height="40" Width="120" FontSize="13" Background="{DynamicResource SecondaryBrush}"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
