<ui:FluentWindow x:Class="ACMECertManager.DnsSecretEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Edit DNS Plugin Credentials"
        Height="600"
        Width="680"
        MinHeight="480"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="Edit DNS Plugin Credentials"
            ShowClose="True"
            ShowMaximize="False"
            ShowMinimize="False"/>

        <Grid Grid.Row="1" Margin="20,12,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock
                    Text="Credential Details"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock
                    Text="Update the domain context and plugin-specific secret values for DNS-01 validation."
                    Margin="0,4,0,0"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <ui:Card Grid.Row="1" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock
                        x:Name="txtPluginName"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock
                        x:Name="txtPluginDescription"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,6,0,0"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Row="2" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock
                            Text="Domain / context hostname"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,0,6"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBox
                            x:Name="txtDomain"
                            PlaceholderText="example.com (leave blank for default/shared credentials)"/>

                        <StackPanel x:Name="pnlCredentialFields" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </ui:Card>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button
                    x:Name="btnSave"
                    Content="Save"
                    Appearance="Primary"
                    Click="Save_Click"
                    MinWidth="120"
                    Margin="0,0,8,0"/>
                <ui:Button
                    Content="Cancel"
                    Appearance="Secondary"
                    Click="Cancel_Click"
                    MinWidth="120"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
