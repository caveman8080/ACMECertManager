<Window x:Class="ACMECertManager.DnsSecretsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage DNS Plugin Secrets" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Warning Banner -->
        <Border Grid.Row="0" Background="{DynamicResource WarningBrush}" Padding="15">
            <TextBlock Text="⚠️ WARNING: Secrets are displayed in plaintext and stored unsecured on disk. Only view/manage these secrets on trusted machines." 
                       FontSize="12" Foreground="White" TextWrapping="Wrap"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Plugin List -->
            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <TextBlock Text="Plugins" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                <ListBox x:Name="lstPlugins" 
                         SelectionChanged="PluginList_SelectionChanged"
                         Background="{DynamicResource InputBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>

            <!-- Credentials Grid -->
            <StackPanel Grid.Column="1" Margin="0">
                <TextBlock x:Name="txtSelectedPlugin" Text="Select a plugin" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <DataGrid x:Name="dgSecrets"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          ColumnWidth="*"
                          MinColumnWidth="80"
                          Background="{DynamicResource InputBackgroundBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          Foreground="{DynamicResource TextBrush}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Margin="0,0,0,15">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="200" MinWidth="150"/>
                        <DataGridTextColumn Header="Credentials" Binding="{Binding CredentialSummary}" Width="*" MinWidth="200"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="btnEdit" Content="✏️ Edit Selected" Click="Edit_Click" Height="40" Width="150" FontSize="13" Margin="0,0,10,0"/>
                    <Button x:Name="btnDelete" Content="🗑 Delete Selected" Click="Delete_Click" Height="40" Width="150" FontSize="13" Margin="0,0,10,0" Background="{DynamicResource WarningBrush}"/>
                    <Button x:Name="btnAdd" Content="➕ Add New" Click="Add_Click" Height="40" Width="120" FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15" Height="50">
            <Button Content="Close" Click="Close_Click" Height="40" Width="120" FontSize="14" Background="{DynamicResource SecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>
