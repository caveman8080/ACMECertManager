<ui:FluentWindow x:Class="ACMECertManager.DnsSecretsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Manage DNS Plugin Secrets"
        Height="680"
        Width="1080"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="Manage DNS Plugin Secrets"
            ShowClose="True"
            ShowMaximize="True"
            ShowMinimize="False"/>

        <Grid Grid.Row="1" Margin="20,12,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock
                    Text="DNS Plugin Secrets"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock
                    Text="Review, add, edit, or remove stored credentials used by DNS-01 validation plugins."
                    Margin="0,4,0,0"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <ui:InfoBar
                Grid.Row="1"
                Title="Plaintext secret storage"
                Message="Secrets are displayed in plaintext and stored unsecured on disk. Only view or manage these secrets on trusted machines."
                Severity="Warning"
                IsOpen="True"
                IsClosable="False"
                Margin="0,0,0,14"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Margin="0,0,12,0" Padding="0">
                    <DockPanel>
                        <Border
                            DockPanel.Dock="Top"
                            Padding="16,14,16,12"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock
                                    Text="Plugins"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock
                                    Text="Select a plugin to manage its credentials."
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <ListBox
                            x:Name="lstPlugins"
                            SelectionChanged="PluginList_SelectionChanged"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="8"
                            Margin="0"/>
                    </DockPanel>
                </ui:Card>

                <ui:Card Grid.Column="1" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="16,14,16,12"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock
                                    x:Name="txtSelectedPlugin"
                                    Text="Select a plugin"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock
                                    Text="Stored credentials for the selected plugin appear below."
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <ui:DataGrid
                            x:Name="dgSecrets"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            HeadersVisibility="Column"
                            GridLinesVisibility="Horizontal"
                            BorderThickness="0"
                            ColumnWidth="*"
                            MinColumnWidth="80"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            Margin="12,8,12,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Domain" Binding="{Binding Domain, Mode=OneWay}" Width="220" MinWidth="150"/>
                                <DataGridTextColumn Header="Credentials" Binding="{Binding CredentialSummary, Mode=OneWay}" Width="*" MinWidth="200"/>
                            </DataGrid.Columns>
                        </ui:DataGrid>

                        <Border
                            Grid.Row="2"
                            Padding="16,12"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <ui:Button
                                    x:Name="btnEdit"
                                    Content="Edit Selected"
                                    Icon="{ui:SymbolIcon Edit24}"
                                    Appearance="Secondary"
                                    Click="Edit_Click"
                                    MinWidth="140"
                                    Margin="0,0,8,0"/>
                                <ui:Button
                                    x:Name="btnDelete"
                                    Content="Delete Selected"
                                    Icon="{ui:SymbolIcon Delete24}"
                                    Appearance="Danger"
                                    Click="Delete_Click"
                                    MinWidth="150"
                                    Margin="0,0,8,0"/>
                                <ui:Button
                                    x:Name="btnAdd"
                                    Content="Add New"
                                    Icon="{ui:SymbolIcon Add24}"
                                    Appearance="Primary"
                                    Click="Add_Click"
                                    MinWidth="120"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ui:Card>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button Content="Close" Appearance="Secondary" Click="Close_Click" MinWidth="120"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
