<Window x:Class="ACMECertManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grok ACME Certificate Manager" Height="650" Width="1000"
        Background="#F5F5F5">
    <Grid Margin="10">
        <TabControl TabStripPlacement="Top" Background="White">
            <!-- Dashboard -->
            <TabItem Header="📊 Dashboard">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎉 Welcome to Grok ACME Certificate Manager!" FontSize="24" FontWeight="Bold" Margin="0,20"/>
                    <TextBlock Text="Always starts in SAFE STAGING mode." FontSize="16" Foreground="Green" Margin="0,10"/>
                    <Button Content="Issue Your First Certificate →" Click="IssueButton_Click" Height="50" Width="300" FontSize="18" Background="#00BFFF" Foreground="White"/>
                </StackPanel>
            </TabItem>

            <!-- Issue New Certificate Wizard -->
            <TabItem Header="✨ Issue New Certificate">
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="Domain(s) (comma separated, supports *.example.com)" FontSize="14" Margin="0,5"/>
                        <TextBox x:Name="txtDomains" Height="30" Margin="0,5"/>
                        
                        <TextBlock Text="Your Email (for Let's Encrypt notifications)" FontSize="14" Margin="0,5"/>
                        <TextBox x:Name="txtEmail" Height="30" Margin="0,5"/>
                        
                        <CheckBox x:Name="chkWildcard" Content="Include wildcard (*.domain.com)" Margin="0,10"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <RadioButton x:Name="rbHttp" Content="HTTP-01 (easiest)" IsChecked="True" Margin="0,0,20,0"/>
                            <RadioButton x:Name="rbDns" Content="DNS-01 (Cloudflare/AWS later)" Margin="0,0,20,0"/>
                        </StackPanel>
                        
                        <CheckBox x:Name="chkProduction" Content="🚨 Go to PRODUCTION (real certificates)" Margin="0,10" Foreground="Red"/>
                        
                        <Button Content="🚀 Issue Certificate Now" Click="IssueCertificate_Click" Height="45" Width="280" FontSize="16" Background="#00BFFF" Foreground="White" Margin="0,20"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Manage Certificates -->
            <TabItem Header="📋 Manage Certificates">
                <DataGrid x:Name="dgCertificates" AutoGenerateColumns="True" Margin="10" IsReadOnly="True"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <Button Content="Renew Selected" Click="Renew_Click" Width="150" Margin="5"/>
                    <Button Content="Revoke Selected" Click="Revoke_Click" Width="150" Margin="5"/>
                </StackPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="⚙️ Settings">
                <StackPanel Margin="20">
                    <TextBlock Text="Auto-renew every 60 days (creates Windows Task)" FontSize="14"/>
                    <Button Content="Enable Auto-Renew Now" Click="EnableAutoRenew_Click" Height="40" Width="250" Margin="0,10"/>
                    <TextBlock Text="All files stay inside this app folder – no mess!" FontSize="12" Margin="0,20"/>
                </StackPanel>
            </TabItem>

            <!-- Logs -->
            <TabItem Header="📜 Logs">
                <TextBox x:Name="txtLogs" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Margin="10" FontFamily="Consolas" FontSize="13"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
