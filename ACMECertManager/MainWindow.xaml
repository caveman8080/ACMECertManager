<Window x:Class="ACMECertManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grok ACME Certificate Manager" Height="600" Width="900"
        Background="#F0F0F0">
    <Grid>
        <TabControl Margin="10" TabStripPlacement="Top">
            <TabItem Header="📊 Dashboard">
                <TextBlock Text="Welcome! Ready to issue free certificates? 🎉&#10;Default = Staging mode (safe)" 
                           FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Green"/>
            </TabItem>
            <TabItem Header="✨ Issue New Certificate"/>
            <TabItem Header="📋 Manage Certificates"/>
            <TabItem Header="⚙️ Settings"/>
            <TabItem Header="📜 Logs">
                <TextBlock Text="Logs will appear here..." FontSize="14" Margin="10"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
